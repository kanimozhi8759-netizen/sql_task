CREATE OR REPLACE PROCEDURE RE_FRESH AS
BEGIN
DELETE FROM EMPLOYEES_DEATIL;
INSERT INTO EMPLOYEES_DEATIL  SELECT * FROM EMPLOYEES_DETAIL;
INSERT INTO TRACK VALUES(SQ_NEXT.NEXTVAL,'ACTIVE',SYSTIMESTAMP);
END;
/


SELECT * FROM USER_ALL_TABLES;
SELECT * FROM EMPLOYEES_DETAIL;
SELECT * FROM EMPLOYEES_DEATIL;
CREATE TABLE TRACK (ROLL_NUMBER NUMBER,
                                                STATUS  VARCHAR2(50),
                                                TIME_PERIOD TIMESTAMP);
                                                
  CREATE  SEQUENCE SQ_NEXT;                                              
                                                
SELECT SQ_NEXT.NEXTVAL FROM DUAL;                                     
                                                
 BEGIN
 DBMS_SCHEDULER.CREATE_JOB
 (
 JOB_NAME=>'TRACK',
 JOB_TYPE=>'STORED_PROCEDURE',
 JOB_ACTION=> 'RE_FRESH',
 START_DATE=>'08/JAN/2026 07:50:00 PM',
 REPEAT_INTERVAL=>'FREQ=SECONDLY;INTERVAL=5;',
 END_DATE=>'08/JAN/2026 07:58:00 PM',
 AUTO_DROP=>TRUE,
 ENABLED=>TRUE,
 COMMENTS=>'ITS REFRESH EVERY 5 SEC ONCE'
 );
 END;
 /
 SELECT * FROM TRACK;
 SELECT * FROM USER_SCHEDULER_JOBS;
 
 SELECT * FROM TRACK ORDER BY ROLL_NUMBER ASC;                    
  

DECLARE
V_SALARY NUMBER:=90000;
V_TAX NUMBER;
BEGIN
 IF V_SALARY<50000 THEN
 V_TAX:=V_SALARY-(V_SALARY*.05);
     DBMS_OUTPUT.PUT_LINE(V_TAX);
 ELSIF V_SALARY  BETWEEN 50000 AND 100000 THEN
  V_TAX:=V_SALARY-(V_SALARY*.10);
      DBMS_OUTPUT.PUT_LINE(V_TAX);
ELSIF V_SALARY>100000 THEN
  V_TAX:=V_SALARY-(V_SALARY*.20);
    DBMS_OUTPUT.PUT_LINE(V_TAX);
  END IF;
END;

BEGIN
FOR J IN REVERSE 1..10 LOOP 
DBMS_OUTPUT.PUT_LINE(J);
END LOOP;
END;










